{
    "$schema": "https://json-schema.org",
    "title": "crime hotspots",
    "type": "object",
    "properties": {
        "incident_location": {
            "type": "object",
            "properties": {
                "address": {
                    "Street": "string",
                    "Number": "integer",
                    "city": "string",
                    "zip": "integer",
                    "state": "string",
                    "country": "string"
                },
                "coordinates": {
                    "type": "object",
                    "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                    },
                    "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                    }
                }
            },
            "dateTime": {
                "type": "string",
                "format": "date-time"
            },
            "description": "string",
            "category": "string",
            "required": [
                "address",
                "coordinates",
                "dateTime"
            ]
        }
    }
}